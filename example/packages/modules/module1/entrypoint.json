{
    "entries": {
        "token": {
            "handler": "token",
            "trigger": {
                "type": "http",
                "options": {
                    "method": "POST",
                    "route": "/identity/token"
                }
            }
        },
        "revoke": {
            "handler": "revoke",
            "trigger": {
                "type": "http",
                "options": {
                    "method": "DELETE",
                    "route": "/identity/revoke"
                }
            }
        },
        "publishDelayed": {
            "handler": "publishDelayed",
            "trigger": {
                "type": "http",
                "options": {
                    "method": "POST",
                    "route": "/publish-delayed"
                }
            }
        },
        "handleDelayedMessage": {
            "handler": "handleDelayedMessage",
            "trigger": {
                "type": "event",
                "options": {
                    "source": "delay-test",
                    "sourceType": "sqs"
                }
            }
        }
    }
}