{
	"name": "@cloudnux/cli",
	"version": "0.14.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cloudnux/cloudnux.git"
	},
	"bin": {
		"nux": "dist/cli.mjs"
	},
	"main": "./dist/cli.js",
	"types": "./dist/cli.d.ts",
	"exports": {
		".": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.mjs"
		},
		"./defaults": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs"
		}
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsup",
		"build": "tsup",
		"link": "yarn link",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"files": [
		".deploy",
		"dist",
		"package.json",
		"README.md"
	],
	"dependencies": {
		"@types/findup-sync": "^4.0.5",
		"ejs": "^3.1.10",
		"esbuild": "0.25.4",
		"fast-glob": "^3.3.2",
		"findup-sync": "^5.0.0",
		"interpret": "^3.1.1",
		"meow": "^11.0.0",
		"rechoir": "^0.8.0",
		"tsup": "^8.3.5"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"@types/ejs": "^3.1.5",
		"@types/findup-sync": "^4.0.5",
		"@types/rechoir": "^0.6.4",
		"typescript": "^5.0.3"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}