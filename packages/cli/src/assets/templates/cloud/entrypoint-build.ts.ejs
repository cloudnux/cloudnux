import { createRouter } from "@cloudnux/aws-cloud-provider/router";
import { awsCloudProvider, setCurrentModule } from "@cloudnux/aws-cloud-provider";
import {
    httpHandler,
    eventBrokerHandler,
    invokeHandler,
    scheduleHandler,
    websocketHandler,
    useCloudProvider,
  } from "@cloudnux/cloud-sdk";

<%_ for(const svc of serviceOverrides){ _%>
import <%=svc.varName%> from "<%-svc.path%>";
<%_ } _%>
<%_ if (hooks.coldStart) { _%>
import coldStart from "<%-hooks.coldStart%>";
<%_ } _%>

useCloudProvider(awsCloudProvider<% if (serviceOverrides.length) { %>, { serviceFactories: { <%- serviceOverrides.map(svc => `"${svc.kind}": ${svc.varName}`).join(', ') %> } }<% } %>);

setCurrentModule("<%=module%>");
<%_ if (hooks.coldStart) { _%>

// Cold start hook: runs once per Lambda instance, in the init phase,
// before the module's code is loaded. A thrown error fails the init.
await coldStart("<%=module%>");
<%_ } _%>

// The module is loaded only now, after the cloud provider (and the cold start
// hook), so its import-time code can use cloudnux services and sees the
// prepared environment. esbuild keeps this import inside the bundle.
const src = await import("../../../packages/modules/<%=module%>/src");

const router = createRouter();
<%_ for(var [key,entry] of Object.entries(entries)) { _%>
    <%_ if(entry.trigger.type.toLowerCase() === "http") { _%>
router.http(
        "<%= entry.trigger.options.method %>",
        "<%= entry.trigger.options.route %>",
        (event, context) => {
            return httpHandler(src["<%= entry.handler %>"], event, context);
        }
);
    <%_ } _%>
    <%_ if(entry.trigger.type.toLowerCase() === "schedule") { _%>
router.schedule(
        "<%= entry.trigger.options.name %>",
        "<%= entry.trigger.options.pattern %>",
        (event, context) => {
            return scheduleHandler(src["<%= entry.handler %>"], event, context);
        }
);
    <%_ } _%>
    <%_ if(entry.trigger.type.toLowerCase() === "event") { _%>
router.event(
             "<%= entry.trigger.options.source %>",
             "<%= entry.trigger.options.sourceType %>",
             (event, context) => {
                return eventBrokerHandler(src["<%= entry.handler %>"], event, context);
            }
); 
    <%_ } _%>
    <%_ if(entry.trigger.type.toLowerCase() === "websocket") { _%>
        <%_ const wsRouteKey = entry.trigger.options.event === "connect" ? "$connect" : entry.trigger.options.event === "disconnect" ? "$disconnect" : entry.trigger.options.route || "$default" _%>
router.websocket(
            "<%= wsRouteKey %>",
            (event, context) => {
                return websocketHandler(src["<%= entry.handler %>"],event,context, <%- JSON.stringify(entry.trigger, null, 2) %> );
            }
);
    <%_ } _%>
    <%_ if(entry.trigger.type.toLowerCase() === "invoke") { _%>
router.invoke(
        "<%= entry.trigger.options.name %>",
        (event, context) => {
            return invokeHandler(src["<%= entry.handler %>"], event, context);
        }
);
    <%_ } _%>
<%_ } _%>

export async function handler(event, context) {
    const response = await router.run(event, context);
    return response;
}