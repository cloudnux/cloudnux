import fs from 'node:fs';
import path from 'node:path';
import { useCloudProvider } from "@cloudnux/cloud-sdk";
import { createRouter, localCloudProvider, configureLocalInvoke } from '@cloudnux/local-cloud-provider';
import { queuesPlugin } from "@cloudnux/local-cloud-provider/queue-plugin";
import { schedulerPlugin } from "@cloudnux/local-cloud-provider/schedule-plugin";
import { devConsolePlugin } from "@cloudnux/local-cloud-provider/dev-console-plugin";
import { websocketsPlugin } from "@cloudnux/local-cloud-provider/websocket-plugin";
import { invokesPlugin } from "@cloudnux/local-cloud-provider/invoke-plugin";
import { storagePlugin } from "@cloudnux/local-cloud-provider/storage-plugin";
<%_ for(const svc of serviceOverrides){ _%>
import <%=svc.varName%> from "<%-svc.path%>";
<%_ } _%>
<%_ if (hooks.coldStart) { _%>
import coldStart from "<%-hooks.coldStart%>";
<%_ } _%>

// The environment folder is resolved by the CLI at render time. Every local
// data folder lives inside it; the dev server must never run without it.
const ENV_DIR = <%- JSON.stringify(envDir) %>;
if (!fs.existsSync(ENV_DIR)) {
  throw new Error(`Environment folder not found: ${ENV_DIR}`);
}

// Absolute paths are kept as-is, relative ones resolve against the env folder
const envPath = (value: string | undefined, defaultName: string) => path.resolve(ENV_DIR, value || defaultName);

process.env.DEV_CLOUD_LOCATION_PATH = envPath(process.env.DEV_CLOUD_LOCATION_PATH, '.local-location');
process.env.DEV_CLOUD_STORAGE_BUCKET = envPath(process.env.DEV_CLOUD_STORAGE_BUCKET, '.local-storage');
process.env.DEV_CLOUD_EMAIL_DIR = envPath(process.env.DEV_CLOUD_EMAIL_DIR, '.local-email');
<%_ if (secretsFile) { _%>
// Local secrets service: environments.develop.secretsFile in nux.config
process.env.DEV_CLOUD_SECRETS_FILE = <%- JSON.stringify(secretsFile) %>;
<%_ } _%>
// Queues and topics live in this dev server unless DEV_CLOUD_EVENT_BROKER_URL
// points to another one (the queue plugin is registered under /queues)
process.env.DEV_CLOUD_EVENT_BROKER_URL = process.env.DEV_CLOUD_EVENT_BROKER_URL || 'http://localhost:<%=port%>/queues';
// Public base URL of the storage plugin, used to build signed upload/download URLs
process.env.DEV_CLOUD_STORAGE_URL = process.env.DEV_CLOUD_STORAGE_URL || 'http://localhost:<%=port%>/__storage';

useCloudProvider(localCloudProvider<% if (serviceOverrides.length) { %>, { serviceFactories: { <%- serviceOverrides.map(svc => `"${svc.kind}": ${svc.varName}`).join(', ') %> } }<% } %>);

configureLocalInvoke({ namespace: <%- JSON.stringify(namespace) %>, namespaces: <%- JSON.stringify(namespaces ?? {}) %> });

// Modules are loaded only after the cloud provider is set up. With a cold start
// hook, the hook runs for each module before that module's code is loaded,
// the same order as a cold start in the cloud.
<%_ for(const module of moduleNames){ _%>
<%_ if (hooks.coldStart) { _%>
await coldStart("<%=module%>");
<%_ } _%>
const <%=module%>Entries = (await import("./<%=module%>")).default;
<%_ } _%>

const router = createRouter();

router.register(queuesPlugin, { prefix: "queues", config: { persistence: { directory: path.join(ENV_DIR, '.queue-data') } } });
router.register(schedulerPlugin, { prefix: "schedules", config: { persistence: { directory: path.join(ENV_DIR, '.scheduler-data') } } });
router.register(devConsolePlugin, {  prefix: 'console' });
router.register(websocketsPlugin, { prefix: "websockets" });
router.register(invokesPlugin);
router.register(storagePlugin, { prefix: "__storage" });

<%_ for(const module of moduleNames){ _%>
  router.register(<%=module%>Entries, { prefix: "api" });
<%_ } _%>

router.listen({ port: <%=port%>, host: "::" }, (err) => {
  if (err) {
    console.error('Error starting server:', err);
    process.exit(1);
  }
  else
    console.log(`Server listening on port ${router?.server?.address()?.port} ...`)
});