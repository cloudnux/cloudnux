{
  "name": "@cloudnux/azure-cloud-provider",
  "description": "CloudNux Azure cloud provider implementation",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudnux/cloudnux.git",
    "directory": "packages/cloud-providers/azure"
  },
  "keywords": [
    "cloud",
    "azure",
    "blob-storage",
    "functions",
    "provider",
    "azure-maps",
    "location",
    "service-bus",
    "communication-services",
    "email"
  ],
  "scripts": {
    "link": "yarn link",
    "build": "tsup",
    "yalc:publish": "yalc publish --private",
    "yalc:push": "yalc push --private",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:live:entra": "LIVE_AUTH=entra vitest run --config vitest.live.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/identity": "^4.10.0",
    "@azure/service-bus": "^7.10.0",
    "@azure/storage-blob": "^12.28.0",
    "@cloudnux/core-cloud-provider": "0.22.0",
    "@cloudnux/utils": "0.0.2",
    "i18n-iso-countries": "^7.14.0",
    "long": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "azurite": "^3.35.0",
    "vitest": "^4.0.14"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
